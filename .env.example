# Copy to .env and set the directory containing your own workout templates/notes.
# .env stays local; launch with uv run --env-file .env gym-web.
# Without an override, the default is data/raw/workout inside this checkout.
GYM_WORKOUT_DIR=data/raw/workout
# Optional: confirm unmarked historical notes through an ISO date you have reviewed.
# GYM_LEGACY_THROUGH=YYYY-MM-DD
GYM_TIMEZONE=UTC
GYM_PORT=8010
# Exact hostnames accepted by the app; add your hostname when hosting behind a protected proxy.
GYM_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
GYM_DATABASE_PATH=data/app/gym.sqlite3
GYM_WAREHOUSE_PATH=data/warehouse/gym.duckdb
# Local recording defaults to no login. Enable authentication for hosted use.
GYM_AUTH_ENABLED=false
# GYM_PUBLIC_URL=https://gym.example.com
# GYM_ALLOWED_EMAIL=owner@example.com
# GYM_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# GYM_GOOGLE_CLIENT_ID=
# GYM_GOOGLE_CLIENT_SECRET=
