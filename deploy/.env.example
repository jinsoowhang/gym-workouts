GYM_PUBLIC_HOST=gym.example.com
GYM_STATE_DIR=/opt/gym-workouts-state
# A folder already synced with your Obsidian vault, containing your workout templates.
GYM_WORKOUT_DIR=/opt/vault/raw/assets/workout
GYM_TIMEZONE=UTC
GYM_PORT=8010
# Match the account that owns the synced workout folder.
GYM_UID=10001
GYM_GID=10001
# Set these after creating the protected Cloudflare Access application and tunnel.
GYM_TUNNEL_DIR=/opt/gym-workouts-tunnel
GYM_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0
