GYM_PUBLIC_HOST=gym.example.com
GYM_STATE_DIR=/opt/gym-workouts-state
# A folder already synced with your Obsidian vault, containing your workout templates.
GYM_WORKOUT_DIR=/opt/vault/raw/assets/workout
GYM_TIMEZONE=UTC
GYM_PORT=8010
# Match the account that owns the synced workout folder.
GYM_UID=10001
GYM_GID=10001
# The private Docker network and exact proxy address (inspect your proxy container).
GYM_PROXY_NETWORK=npm_default
GYM_PROXY_IPS=REPLACE_WITH_PROXY_CONTAINER_IP
# Keep the actual approved address and credentials only in the VPS's private .env.
GYM_ALLOWED_EMAIL=owner@example.com
GYM_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GYM_GOOGLE_CLIENT_ID=
GYM_GOOGLE_CLIENT_SECRET=
